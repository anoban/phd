> options(mc.cores = 8)
> options(loo.cores = 8)
> 
> library("ggplot2") # ggsave
> 
> LOG_RESPONSE <- TRUE
> MODELS <- c("M1", "M2", "M3", "M4", "N1", "N2", "N3", "N4")
> MODELS <- MODELS[file.exists(file.path("output", sprintf("%s_fit.Rds", MODELS)))]
> if (!length(MODELS)) stop("no fits in output/; run run_all.R first")
> 
> cat(sprintf("response scale: %s | models: %s\n", if (LOG_RESPONSE) "log" else "original", paste(MODELS, collapse = ", ")))
response scale: log | models: M1, M2, M3, M4, N1, N2, N3, N4
> 
> ## data once per distinct right-hand side (M* use `state`, N* use `1`)
> anoban_data_for <- local({
+   cache <- list()
+   function(predictor) {
+     key <- paste0("rhs_", predictor)
+     if (is.null(cache[[key]])) {
+       cache[[key]] <<- build_anoban_data("./data/stan.csv", "./data/FRED4_1301.tre", log_response = LOG_RESPONSE, predictor = predictor)
+     }
+     cache[[key]]
+   }
+ })
> 
> plots <- list()
> for (m in MODELS) {
+ 
+   cat(sprintf("\n── %s ──\n", m))
+   fit <- readRDS(file.path("output", sprintf("%s_fit.Rds", m))) # saved fit
+   pit_obj <- anoban_loo_pit(m, anoban_data_for(ANOBAN_MODELS[[m]]$predictor), fit, stan_dir = "stan") # LOO-PIT
+ 
+   plots[[m]] <- plot_anoban_loo_pit(pit_obj) # LOO-PIT plots via bayesplot
+   # fname <- file.path("output", sprintf("loo_pit_%s.pdf", m)) # opt for .png files instead of .pdfs
+ 
+   # ggsave(filename = fname, plot = plots[[m]], device = "pdf", width = 16, height = 5)
+   # the server does not have the Cairo linux package installed, without that, installing the R package Cairo won't help
+   # ggplot2::ggsave seem to require Cairo to serialize plots as .png files
+   # png(filename = fname, width = 16, height = 5)#, units = "in", res = 500, type = "cairo-png")
+   # print(plots[[m]]) # print to device
+   # dev.off()
+ 
+   # using png() results in figures not having the red tails Aki suggested????
+ 
+   cat(sprintf("%s completed!\n", m))
+ 
+ }

